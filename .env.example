# Copier vers .env et renseigner deux clés aléatoires distinctes (16 caractères minimum).
# Ou lancer ticket config pour générer un nouveau .env sans écraser l'existant.
TICKET_API_KEY_CLIENT=
TICKET_API_KEY_ADMIN=
TICKET_MODEL=models/tickets.joblib
TICKET_DB=var/tickets.sqlite3
TICKET_THRESHOLD=0.45
TICKET_API_URL=http://127.0.0.1:8000
# Syntaxe .env simple uniquement, sans export ni interpolation ni commentaire de fin de ligne.
